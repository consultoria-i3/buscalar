{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/sala", "destination": "/index" },
    { "source": "/sala/:code", "destination": "/index" }
  ],
  "headers": [
    { "source": "/mascota/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=604800" } ] },
    { "source": "/sala/(.*)", "headers": [ { "key": "Cache-Control", "value": "no-store" } ] },
    { "source": "/", "headers": [ { "key": "Cache-Control", "value": "no-store" } ] }
  ]
}
